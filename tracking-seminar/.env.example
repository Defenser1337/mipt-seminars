# Скопируйте в .env и заполните своими значениями.
# .env в git не попадает (см. .gitignore).

# --- Weights & Biases ---
# Ключ: https://wandb.ai/authorize
WANDB_API_KEY=
# Команда/пользователь, куда писать запуски (необязательно)
# WANDB_ENTITY=your-team
# online | offline | disabled
WANDB_MODE=online

# --- Comet ---
# Ключ: https://www.comet.com/account-settings/apiKeys
COMET_API_KEY=
# Рабочее пространство Comet (необязательно)
# COMET_WORKSPACE=your-workspace

# --- MLflow ---
# Локальный сервер в ноутбуке не требует ключей.
# Для удалённого сервера раскомментируйте и заполните:
# MLFLOW_TRACKING_URI=https://mlflow.example.com
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=
# MLFLOW_TRACKING_TOKEN=
